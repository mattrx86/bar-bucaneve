# BUCA SLUG - copiate questo file come ".env" nella stessa cartella e compilatelo.
# Il file .env contiene password: NON va su GitHub (e' gia' escluso da .gitignore).

# MariaDB 10 di Synology, sul NAS stesso. La porta la vedete nell'app "MariaDB 10" di DSM (di solito 3306 o 3307).
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=bucaslug
DB_USER=bucaslug
DB_PASS=la_stessa_password_messa_in_01_database_e_utente.sql

# Segreto per l'impronta degli indirizzi IP (si salvano solo impronte, mai gli IP).
# Generatelo una volta con:  openssl rand -hex 32
PEPE=incollate_qui_64_caratteri_casuali
